---
import { SITE } from '../consts';
---
<!--
  手機版底部固定導覽列 — 2026-08-11 新增（原本 78ok/888ry8/T8super/YOU888 這幾站沒有這個功能，
  是 88win／利亨／好贏／大撈家等站原本就有的元件，這次補齊讓全站架構一致）。
  放在 Base.astro 裡，所以全站每一頁手機版都會有，不是只有首頁。
  「推薦」「我的」為會員專屬功能，未登入時彈出登入提醒；「客服」直接開官方 LINE；
  「首頁」「優惠」為一般連結，不特別標記 active（跨頁共用元件，不同頁面各自的 active 邏輯留給未來需要時再加）。
-->
<nav class="mbn-bar" aria-label="手機版底部導覽">
  <a href="/promotions/"><span aria-hidden="true">🏷️</span>優惠</a>
  <a href={SITE.lineUrl} target="_blank" rel="nofollow noopener"><span aria-hidden="true">💬</span>客服</a>
  <a href="/"><span aria-hidden="true">🏠</span>首頁</a>
  <a href="#" class="mbn-trigger"><span aria-hidden="true">📣</span>推薦</a>
  <a href="#" class="mbn-trigger"><span aria-hidden="true">😊</span>我的</a>
</nav>
<div class="mbn-modal" id="mbn-modal">
  <div class="mbn-bg"></div>
  <div class="mbn-box">
    <button type="button" class="mbn-close" aria-label="關閉">✕</button>
    <h3>登入提醒</h3>
    <p>此功能需要登入才能使用<br />請登入或註冊</p>
  </div>
</div>
<style>
  .mbn-bar { display: none; }
  @media (max-width: 820px) {
    :global(body) { padding-bottom: 60px; }
    .mbn-bar {
      display: flex;
      position: fixed;
      bottom: 0;
      left: 0;
      right: 0;
      height: 60px;
      background: #fff;
      border-top: 1px solid #e3ebf5;
      justify-content: space-around;
      align-items: center;
      z-index: 60;
      box-shadow: 0 -3px 12px rgba(0, 0, 0, 0.08);
    }
    .mbn-bar a {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 2px;
      font-size: 11px;
      color: #8a99b0;
      text-decoration: none;
    }
    .mbn-bar a span { font-size: 19px; }
  }
  .mbn-modal {
    position: fixed;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 200;
    opacity: 0;
    visibility: hidden;
    transition: 0.2s;
  }
  .mbn-modal.show { opacity: 1; visibility: visible; }
  .mbn-bg { position: absolute; inset: 0; background: rgba(10, 25, 50, 0.55); }
  .mbn-box {
    position: relative;
    width: 300px;
    max-width: 88vw;
    background: #fff;
    border-radius: 18px;
    padding: 26px 22px 20px;
    text-align: center;
    box-shadow: 0 18px 50px rgba(0, 0, 0, 0.3);
  }
  .mbn-close {
    position: absolute;
    top: 10px;
    right: 10px;
    width: 28px;
    height: 28px;
    border: 0;
    border-radius: 50%;
    background: #f0f3f7;
    color: #5b6b82;
    font-size: 14px;
    cursor: pointer;
  }
  .mbn-box h3 { font-size: 19px; color: #16233c; margin: 0 0 12px; }
  .mbn-box p { font-size: 14px; color: #5b6b82; line-height: 1.7; margin: 0; }
</style>
<script>
  const modal = document.getElementById('mbn-modal');
  document.querySelectorAll('.mbn-trigger').forEach((el) => {
    el.addEventListener('click', (e) => {
      e.preventDefault();
      modal?.classList.add('show');
    });
  });
  modal?.querySelector('.mbn-bg')?.addEventListener('click', () => modal.classList.remove('show'));
  modal?.querySelector('.mbn-close')?.addEventListener('click', () => modal.classList.remove('show'));
</script>
